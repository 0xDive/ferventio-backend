# Copy to .env. Never commit .env or files under .secrets/.
LISTEN_ADDRESS=:8080
BACKEND_PORT=8080

# PostgreSQL. The compose file builds DATABASE_URL from these values.
POSTGRES_DB=ferventio
POSTGRES_USER=ferventio
POSTGRES_PASSWORD=replace-with-a-long-url-safe-random-password
# Used by native runs; Compose overrides this value with the internal postgres hostname.
DATABASE_URL=postgres://ferventio:replace-with-a-long-url-safe-random-password@127.0.0.1:5432/ferventio?sslmode=disable
DATABASE_MAX_CONNS=20
DATABASE_MIN_CONNS=2
DATABASE_MAX_CONN_LIFETIME=30m
DATABASE_MAX_CONN_IDLE_TIME=5m
DATABASE_CONNECT_TIMEOUT=10s
DATABASE_MIGRATE=true

ADMIN_TOKEN=replace-with-a-long-random-token

# Public HTTPS address reachable by Twitch.
PUBLIC_BASE_URL=https://ferventio.example.com
EVENTSUB_CALLBACK_URL=https://ferventio.example.com/v1/eventsub/webhook
EVENTSUB_SECRET=

# Twitch confidential application.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URL=https://ferventio.example.com/v1/auth/twitch/callback
AUTH_ENCRYPTION_KEY=
# Native app callback schemes. Keep production and debug bundle schemes explicit.
AUTH_ALLOWED_APP_SCHEMES=io.ferventio.app,io.ferventio.app.debug,io.ferventio.ios,io.ferventio.ios.debug
# Keep the complete scope list quoted so dotenv/shell tooling treats it as one value.
# Ferventio authenticates as the signed-in user, not as a Twitch chat bot.
TWITCH_AUTH_SCOPES="user:read:chat user:write:chat moderator:manage:chat_messages moderator:manage:banned_users user:read:moderated_channels moderator:read:followers moderator:manage:chat_settings moderator:read:chatters clips:edit channel:manage:broadcast channel:moderate moderator:manage:warnings user:manage:blocked_users moderator:manage:automod moderator:read:blocked_terms moderator:read:unban_requests moderation:read moderator:read:banned_users moderator:read:moderators moderator:read:vips channel:read:vips channel:read:subscriptions channel:read:redemptions channel:manage:polls channel:manage:predictions user:read:emotes"
AUTH_SESSION_TTL=8760h
AUTH_STATE_TTL=10m
AUTH_HANDOFF_TTL=2m
AUTH_LEASE_TTL=60s
AUTH_ACCESS_REFRESH_AHEAD=2h
TWITCH_ID_BASE_URL=https://id.twitch.tv
TWITCH_HELIX_BASE_URL=https://api.twitch.tv/helix

# Play flavor / FCM. Disabled by default; compose.fcm.yaml enables it explicitly.
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_FILE=./.secrets/firebase-service-account.json

# iOS / APNs token authentication. Keep the Apple .p8 key outside the repository and
# provide APNS_PRIVATE_KEY_BASE64 as base64 of the complete PEM file contents.
APNS_ENABLED=false
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY_BASE64=
APNS_BUNDLE_ID=io.ferventio.ios
# production uses api.push.apple.com; sandbox uses api.sandbox.push.apple.com.
APNS_ENVIRONMENT=production

# Optional Web Push compatibility.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBSCRIBER=mailto:admin@example.com

RATE_LIMIT_DISABLED=false
RATE_LIMIT_GENERAL_PER_MINUTE=300
RATE_LIMIT_GENERAL_BURST=60
RATE_LIMIT_AUTH_PER_MINUTE=60
RATE_LIMIT_AUTH_BURST=15
RATE_LIMIT_INSTALLATION_PER_MINUTE=120
RATE_LIMIT_INSTALLATION_BURST=30
RATE_LIMIT_ADMIN_PER_MINUTE=120
RATE_LIMIT_ADMIN_BURST=30
RATE_LIMIT_MAX_KEYS=50000
RATE_LIMIT_IDLE_TTL=30m
RATE_LIMIT_TRUSTED_PROXY_CIDRS=
